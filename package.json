{
  "name": "opsc",
  "version": "0.0.1",
  "description": "Typed infrastructure scripting, compiled to a native binary.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    "./env": "./src/env.ts",
    "./fs": "./src/fs.ts",
    "./zip": "./src/zip.ts",
    "./http": "./src/http.ts",
    "./exec": "./src/exec.ts",
    "./prompt": "./src/prompt.ts"
  },
  "scripts": {
    "test": "node --test src/**/*.test.ts examples/**/*.test.ts",
    "test:scriptc": "node test/scriptc-smoke.ts",
    "test:all": "pnpm run typecheck && pnpm run test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "typescript",
    "scriptc",
    "infrastructure",
    "ops",
    "cli"
  ],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
